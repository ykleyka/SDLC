@startuml st-01-group-member
!include style.iuml
title Диаграммы состояний: группа и участник

state "Группа" as Group {
  [*] --> Active : создание
  state "Активна" as Active {
    [*] --> Empty
    state "Без трат" as Empty
    state "С тратами" as WithExpenses
    Empty --> WithExpenses : добавлена первая трата
    WithExpenses --> Empty : удалена последняя трата
  }
  state "В архиве" as Archived
  Archived : только просмотр: траты, погашения\nи участники не меняются
  Active --> Archived : в архив [создатель]
  Archived --> Active[H] : вернуть из архива [создатель]
}
note bottom of Group
  Валюта группы не меняется после добавления
  первой траты (REQ-FUNC-003).
end note

state "Участник" as Member {
  state start <<choice>>
  [*] --> start
  start --> Virtual : [добавлен по имени]
  start --> Linked : [создал группу или\nвступил по ссылке]
  state "Виртуальный" as Virtual
  state "С аккаунтом" as Linked
  state "Удалён" as Removed
  Virtual --> Removed : удалить [создатель,\nбаланс = 0]
  Linked --> Removed : удалить [создатель, баланс = 0,\nудаляемый не создатель]
  Removed --> [*]
}
@enduml
